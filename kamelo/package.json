{
  "name": "koshotel-smart-manager",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "test": "node --test tests/*.test.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "typecheck": "tsc --noEmit",
    "test:integration": "node tests/integration.mjs",
    "test:tenant": "node tests/tenant-smart.integration.mjs",
    "db:local": "node scripts/local-db.mjs",
    "db:seed": "node scripts/seed.mjs",
    "test:operations": "node tests/operations.integration.mjs",
    "worker": "node scripts/operations-worker.mjs",
    "test:acquisition": "node tests/acquisition.integration.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.16.0",
    "lucide-react": "^0.468.0",
    "next": "^15.5.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "embedded-postgres": "18.4.0-beta.17",
    "prettier": "^3.9.10",
    "prisma": "^6.16.0",
    "typescript": "^5.9.0"
  }
}
