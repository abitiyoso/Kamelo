DATABASE_URL="postgresql://koshotel:koshotel_local@localhost:5432/koshotel"
APP_URL="http://127.0.0.1:3000"
# Server-only transactional email; outbound delivery is disabled by default.
# Local QA: sink + loopback APP_URL. SMTP requires live gate AND recipient allowlist.
MAIL_DRIVER="disabled"
MAIL_LIVE_ENABLED="false"
MAIL_TEST_RECIPIENTS=""
EMAIL_FROM_NAME="Kamelo by ELENIO"
EMAIL_FROM_ADDRESS="hello@elenio.id"
EMAIL_REPLY_TO="hello@elenio.id"
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_USERNAME=""
SMTP_PASSWORD=""
# Optional legacy HTTPS adapter, subject to the same live gate.
MAIL_ENDPOINT=""
MAIL_API_KEY=""
# Persistent private volume for uploaded payment evidence (never under public/).
PROOF_STORAGE_DIR=""
# Required on a hosted instance for simulated access PIN encryption: 32-byte key in hex.
DATA_ENCRYPTION_KEY=""
# Server + worker shared secret, at least 64 random characters. Never NEXT_PUBLIC_.
# The local convenience runner creates an ephemeral key for its child processes.
OPERATIONS_JOB_KEY=""

# Bounded identity policy (verification 1-30m, reset 5-120m, attempts 1-10, resend 30-3600s).
IDENTITY_VERIFICATION_MINUTES="10"
IDENTITY_RESET_MINUTES="60"
IDENTITY_MAX_ATTEMPTS="5"
IDENTITY_RESEND_SECONDS="60"
